{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": { "width": 14 },
    "separator": ""
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/archlogo.txt",
    "padding": { "top": 1, "left": 1 },
    "color": {
      "1": "#89b4fa",
      "2": "#f5c2e7",
      "3": "#cdd6f4"
    }
  },
  "modules": [
    { "type": "title", "key": "╭─ \uf007  USER", "keyColor": "#cdd6f4" },
    { "type": "host", "key": "├─ \uf109  SYS", "keyColor": "#cdd6f4" },
    { "type": "os", "key": "├─ \uf303  OS", "keyColor": "#f5c2e7", "format": "{name} {version-id}" },
    { "type": "kernel", "key": "├─ \uf31a  KERN", "keyColor": "#cba6f7" },
    { "type": "wm", "key": "├─ \uf359  WM", "keyColor": "#f38ba8" },
    { "type": "packages", "key": "├─ \uf487  PKGS", "keyColor": "#eba0ac", "format": "{all}" },
    { "type": "terminal", "key": "├─ \uf489  TERM", "keyColor": "#fab387" },
    { "type": "shell", "key": "├─ \uf120  SHELL", "keyColor": "#f9e2af" },
    { "type": "uptime", "keyColor": "#a6e3a1", "key": "├─ \uf017  UP" },
    { "type": "command", "keyColor": "#94e2d5", "key": "├─ \uedc7  AGE", "text": "birth_install=$(stat -c %W /); current=$(date +%s); days=$(( (current - birth_install) / 86400 )); echo \"$days days\"" },
    { "type": "cpu", "key": "├─ \uf4bc  CPU", "keyColor": "#89dceb", "format": "{name} ({cores-physical}C/{cores-logical}T)" },
    { "type": "memory", "key": "├─ \uefc5  RAM", "keyColor": "#89b4fa", "format": "{used} / {total} ({percentage})" },
    { "type": "disk", "key": "├─ \uf0a0  ROOT", "folders": "/", "keyColor": "#b4befe", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "disk", "key": "╰─ \uf0a0  HOME", "folders": "/home", "keyColor": "#b4befe", "format": "{size-used} / {size-total} ({size-percentage})" },
    "break",
    { "type": "custom", "format": "   \u001b[30m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  " }
  ]
}
